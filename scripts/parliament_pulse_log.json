["batch_2086782378010378616_2086784099570577662_2086784546654269594_2086785151309414694_2086786078846152844", "batch_\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u092e\u0902\u0924\u094d\u0930\u0940 \u0936\u094d\u0930\u0940 \u0936\u093f\u0935\u0930\u093e\u091c \u0938\u093f\u0902\u0939 \u091a\u094c\u0939\u093e\u0928 \u0915_\u0921\u0940\u092c\u0940\u091f\u0940 \u091f\u094d\u0930\u093e\u0907\u092c\u0932 \u092a\u094b\u0930\u094d\u091f\u0932 \u0914\u0930 \u091c\u0928\u091c\u093e\u0924\u0940\u092f \u091b\u093e\u0924\u094d\u0930\u0935\u0943_\u0924\u092e\u093f\u0932\u0928\u093e\u0921\u0941 \u092e\u0947\u0902 \u091c\u0928\u091c\u093e\u0924\u0940\u092f \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e_\u092a\u0940\u090f\u092e\u091c\u0947\u092f\u0942\u091c\u0940\u090f \u0915\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u091c\u0928\u091c\u093e\u0924\u0940\u092f \u0938\u092e\u0941\u0926\u093e\u092f\u094b\u0902 _\u0930\u093e\u091c\u094d\u092f\u0938\u092d\u093e \u0915\u0947 \u0938\u092d\u093e\u092a\u0924\u093f \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0926\u0928 \u092e\u0947\u0902 \u0905\u0928\u094d\u092f \u0938", "batch_\u0906\u0924\u094d\u092e\u0928\u093f\u0930\u094d\u092d\u0930 \u092a\u0902\u091a\u093e\u092f\u0924 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e_\u0908-\u0917\u094d\u0930\u093e\u092e\u0938\u094d\u0935\u0930\u093e\u091c \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092a\u0902\u091a\u093e\u092f\u0924\u094b\u0902 \u092e\u0947\u0902 _\u092a\u0936\u094d\u091a\u093f\u092e\u0940 \u092c\u0902\u0917\u093e\u0932 \u092e\u0947\u0902 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0917\u094d\u0930\u093e\u092e \u0938\u094d\u0935\u0930\u093e\u091c_\u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u092a\u0942\u0930\u094d\u0935 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u092a\u0924\u093f \u0936\u094d\u0930\u0940 \u0930\u093e_\u0938\u094b\u0932\u0939\u0935\u0947\u0902 \u0935\u093f\u0924\u094d\